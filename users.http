### GET all users
GET localhost:8080/users

### GET user by id
GET localhost:8080/users/1

### POST create new user
POST localhost:8080/users
Content-Type: application/json

{
  "email": "jannick@example.com",
  "profile": {
    "age": 28,
    "bio": "Loves philosophy and coffee",
    "country": "Italy",
    "favoriteSchoolOfThought": "Stoicism"
  },
  "username": "jannick"
}

### GET userProfile by user id
GET localhost:8080/user-profiles/users/1

### UPDATE user profile
PUT localhost:8080/user-profiles/users/1
Content-Type: application/json

{
  "age": 37,
  "bio": "Loves philosophy and coffee",
  "country": "Italy",
  "favoriteSchoolOfThought": "Stoicism"
}